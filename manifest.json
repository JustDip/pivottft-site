{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "PivotTFT-Dev",
    "author": "PivotTFT",
    "version": "0.1.1",
    "minimum-overwolf-version": "0.230.0",
    "description": "TFT overlay companion — meta comps, items, positioning & lobby scouting. Not endorsed by Riot Games.",
    "dock_button_title": "PivotTFT-Dev",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/desktop-icon.ico",
    "window_icon": "icons/IconMouseOver.png"
  },
  "permissions": [
    "Hotkeys",
    "GameInfo"
  ],
  "data": {
    "start_window": "background",
    "hotkeys": {
      "pivottft_showhide": {
        "title": "Show/Hide PivotTFT Overlay",
        "action-type": "toggle",
        "default": "Ctrl+Shift+F"
      }
    },
    "protocol_override_domains": {
      "googlesyndication": "http"
    },
    "externally_connectable": {
      "matches": [
        "http://*.overwolf.com",
        "https://*.overwolf.com",
        "https://*.google-analytics.com",
        "http://*.google-analytics.com",
        "https://www.googleapis.com",
        "https://*.api.riotgames.com"
      ]
    },
    "force_browser": "user",
    "windows": {
      "background": {
        "file": "background.html",
        "background_optimization": true,
        "is_background_page": true
      },
      "desktop": {
        "file": "desktop.html",
        "desktop_only": true,
        "native_window": true,
        "resizable": true,
        "transparent": true,
        "override_on_update": true,
        "size": {
          "width": 1200,
          "height": 800
        },
        "min_size": {
          "width": 900,
          "height": 600
        }
      },
      "in_game": {
        "file": "in_game.html",
        "in_game_only": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "focus_game_takeover_release_hotkey": "pivottft_showhide",
        "resizable": true,
        "transparent": true,
        "override_on_update": true,
        "topmost": true,
        "start_position": {
          "top": 0,
          "left": 0
        },
        "size": {
          "width": 720,
          "height": 580
        },
        "min_size": {
          "width": 640,
          "height": 110
        }
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [5426]
    },
    "game_events": [5426],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [5426]
        },
        "start_minimized": true
      }
    ]
  }
}
